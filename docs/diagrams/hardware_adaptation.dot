digraph HardwareAdaptation {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.65,
         splines=ortho, fontname="Noto Sans CJK SC", fontsize=18,
         label="不同机器人和电机的底层适配", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#64748b",
        fontname="Noto Sans CJK SC", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Noto Sans CJK SC", fontsize=10,
        arrowsize=0.75, penwidth=1.4];

  motion [label="MotionRuntime\n只看到统一关节", fillcolor="#dbeafe", color="#2563eb"];
  state [label="标准关节状态 / 命令\nrad · rad/s · N·m", fillcolor="#fef3c7", color="#d97706"];
  hardware [label="RobotHardware\n组合整台机器人的电机和总线", fillcolor="#dcfce7", color="#16a34a"];
  transmission [label="JointTransmission\n方向 · 减速比 · 零点 · 单位换算", fillcolor="#dcfce7", color="#16a34a"];

  subgraph cluster_drivers {
    label="不同 MotorDriver"; color="#cbd5e1"; style="rounded";
    unitree [label="Unitree 电机驱动"];
    dm [label="达妙电机驱动"];
    future [label="以后新增的电机驱动"];
  }

  subgraph cluster_transport {
    label="不同 DeviceTransport"; color="#cbd5e1"; style="rounded";
    serial [label="串口 / RS485"];
    can [label="CAN / CAN-FD"];
    ethercat [label="EtherCAT / 其他总线"];
  }

  motors [label="实际电机", shape=cylinder, fillcolor="#fee2e2", color="#dc2626"];
  configs [label="RobotModel\nHardwareProfile\nCalibration / MotorProfile",
           shape=folder, fillcolor="#f1f5f9"];

  motion -> state -> hardware -> transmission;
  transmission -> unitree;
  transmission -> dm;
  transmission -> future;
  unitree -> serial;
  dm -> can;
  future -> ethercat;
  serial -> motors;
  can -> motors;
  ethercat -> motors;
  configs -> hardware [style=dashed, label="选择电机和连接关系"];
  configs -> transmission [style=dashed, label="提供方向、零点和减速比"];

  {rank=same; unitree; dm; future;}
  {rank=same; serial; can; ethercat;}
}
