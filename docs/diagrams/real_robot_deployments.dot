digraph Deployments {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.65,
         splines=ortho, fontname="Noto Sans CJK SC", fontsize=18,
         label="两种实机部署方式", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#64748b",
        fontname="Noto Sans CJK SC", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Noto Sans CJK SC", fontsize=10,
        arrowsize=0.75, penwidth=1.4];

  common [label="motiond / MotionRuntime\n运动状态机 + RL 策略",
          fillcolor="#dbeafe", color="#2563eb", penwidth=2];

  subgraph cluster_linux {
    label="方案 A：纯 Linux"; color="#86efac"; fillcolor="#f0fdf4";
    style="rounded,filled";
    robotd [label="robotd / RobotRuntime\n安全检查 · 关节换算\n电机和 IMU 通信",
            fillcolor="#dcfce7", color="#15803d", penwidth=1.8];
    hw_a [label="Motor + IMU", shape=cylinder, fillcolor="#fee2e2", color="#dc2626"];
    robotd -> hw_a [dir=both, label="串口 / CAN"];
  }

  subgraph cluster_h7 {
    label="方案 B：Linux + STM32H7"; color="#86efac"; fillcolor="#f0fdf4";
    style="rounded,filled";
    gateway [label="robot_gatewayd\n共享内存与网线数据转换", fillcolor="white", color="#16a34a"];
    h7 [label="STM32H7 / RobotRuntime\n最终安全检查 · 固定周期执行\n关节换算 · 电机和 IMU 通信",
        fillcolor="#dcfce7", color="#15803d", penwidth=1.8];
    hw_b [label="Motor + IMU", shape=cylinder, fillcolor="#fee2e2", color="#dc2626"];
    gateway -> h7 [dir=both, label="网线"];
    h7 -> hw_b [dir=both, label="CAN / RS485 / SPI"];
  }

  common -> robotd [dir=both, label="共享内存\nStateFrame / CommandFrame"];
  common -> gateway [dir=both, label="共享内存\nStateFrame / CommandFrame"];
  safe_a [label="最终安全权在 robotd", shape=note, fillcolor="#fff7ed", color="#ea580c"];
  safe_b [label="最终安全权在 STM32H7", shape=note, fillcolor="#fff7ed", color="#ea580c"];
  robotd -> safe_a [style=dashed, arrowhead=none];
  h7 -> safe_b [style=dashed, arrowhead=none];

  {rank=same; robotd; gateway;}
  {rank=same; hw_a; h7;}
  {rank=same; safe_a; hw_b; safe_b;}
}
