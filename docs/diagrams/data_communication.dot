digraph Communication {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.7,
         splines=ortho, fontname="Noto Sans CJK SC", fontsize=18,
         label="三进程仿真数据流", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#64748b",
        fontname="Noto Sans CJK SC", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Noto Sans CJK SC", fontsize=10,
        arrowsize=0.75, penwidth=1.4];

  sources [label="键盘 / 手柄 / 导航", fillcolor="#f8fafc"];
  gateway [label="ros2_gateway", fillcolor="#e0f2fe", color="#0284c7"];
  motion [label="motiond\nMotionRuntime", fillcolor="#dbeafe", color="#2563eb",
          penwidth=2];
  robot [label="robotd\nMuJoCoRobotIO", fillcolor="#ede9fe", color="#7c3aed",
         penwidth=2];

  base [label="BaseCommand\n最新值，可覆盖", fillcolor="#fef3c7", color="#d97706"];
  request [label="ModeRequest\n可靠队列", fillcolor="#ffedd5", color="#ea580c"];
  result [label="ModeRequestResult\n可靠队列", fillcolor="#ffedd5", color="#ea580c"];
  state [label="StateFrame\n最新完整状态", fillcolor="#e0f2fe", color="#0284c7"];
  command [label="CommandFrame\n最新且未过期", fillcolor="#dbeafe", color="#2563eb"];
  status [label="MotionStatus\n最新运行状态", fillcolor="#f1f5f9"];

  sources -> gateway;
  gateway -> base -> motion;
  gateway -> request -> motion;
  motion -> result -> gateway;
  robot -> state -> motion;
  motion -> command -> robot;
  motion -> status;
  status -> gateway [style=dashed];

  latest [label="连续量使用 latest-value slot", shape=note,
          fillcolor="#f0f9ff", color="#0284c7"];
  reliable [label="一次性操作必须返回结果", shape=note,
            fillcolor="#fff7ed", color="#ea580c"];
  state -> latest [style=dashed, arrowhead=none];
  request -> reliable [style=dashed, arrowhead=none];

  {rank=same; base; request; result;}
  {rank=same; state; command; status;}
  {rank=same; latest; reliable;}
}
