digraph Overview {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.7,
         splines=ortho, fontname="Noto Sans CJK SC", fontsize=18,
         label="当前控制系统总览", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#64748b",
        fontname="Noto Sans CJK SC", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Noto Sans CJK SC", fontsize=10,
        arrowsize=0.75, penwidth=1.4];

  inputs [label="键盘 / 手柄 / 导航", fillcolor="#f8fafc"];
  gateway [label="ros2_gateway\n输入归一化与请求转发", fillcolor="#e0f2fe",
           color="#0284c7"];
  motion [label="MotionRuntime\n状态机 + 行为 + RL 策略", fillcolor="#dbeafe",
          color="#2563eb", penwidth=2];
  robotio [label="RobotIO\n统一状态与命令边界", fillcolor="#fef3c7",
           color="#d97706", penwidth=2];

  subgraph cluster_impl {
    label="当前 RobotIO 实现";
    color="#cbd5e1"; style="rounded,dashed";
    mujoco [label="MuJoCoRobotIO\n物理仿真", fillcolor="#ede9fe", color="#7c3aed"];
    replay [label="ReplayRobotIO\n故障回放", fillcolor="#f1f5f9"];
    fake [label="FakeRobotIO\n自动化测试", fillcolor="#f1f5f9"];
  }

  status [label="MotionStatus / 日志 / 画面", fillcolor="#f8fafc",
          style="rounded,filled,dashed"];

  inputs -> gateway [label="原始输入"];
  gateway -> motion [label="BaseCommand / ModeRequest"];
  motion -> robotio [dir=both, label="CommandFrame / StateFrame",
                     color="#2563eb", fontcolor="#1d4ed8"];
  robotio -> mujoco;
  robotio -> replay;
  robotio -> fake;
  motion -> status [style=dashed];
  mujoco -> status [style=dashed, label="画面"];

  {rank=same; mujoco; replay; fake;}
}
