digraph SimulationDebug {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.75,
         splines=ortho, fontname="Noto Sans CJK SC", fontsize=18,
         label="仿真与回放入口", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#64748b",
        fontname="Noto Sans CJK SC", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Noto Sans CJK SC", fontsize=10,
        arrowsize=0.75, penwidth=1.4];

  subgraph cluster_single {
    label="单进程交互仿真"; color="#c4b5fd"; style="rounded";
    terminal [label="终端输入", fillcolor="#f8fafc"];
    runtime1 [label="MotionRuntime", fillcolor="#dbeafe", color="#2563eb"];
    sim1 [label="MuJoCoRobotIO\n物理与画面", fillcolor="#ede9fe", color="#7c3aed"];
    terminal -> runtime1 -> sim1;
    sim1 -> runtime1 [label="StateFrame"];
  }

  subgraph cluster_three {
    label="三进程仿真"; color="#bfdbfe"; style="rounded";
    gateway [label="ros2_gateway", fillcolor="#e0f2fe", color="#0284c7"];
    motion [label="motiond", fillcolor="#dbeafe", color="#2563eb"];
    robot [label="robotd + MuJoCo", fillcolor="#ede9fe", color="#7c3aed"];
    gateway -> motion [label="命令 / 请求"];
    motion -> robot [dir=both, label="CommandFrame / StateFrame"];
  }

  subgraph cluster_replay {
    label="确定性故障回放"; color="#cbd5e1"; style="rounded";
    log [label="故障包\nmanifest + state.bin", shape=folder, fillcolor="#f1f5f9"];
    replay [label="quadruped_replay", fillcolor="#f8fafc"];
    runtime2 [label="MotionRuntime", fillcolor="#dbeafe", color="#2563eb"];
    report [label="状态 / 命令 / 首个差异", fillcolor="#f8fafc"];
    log -> replay -> runtime2 -> report;
  }
}
