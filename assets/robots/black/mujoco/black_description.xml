<mujoco model="black_description">
  <compiler angle="radian" meshdir="assets"/>
  <!--
    timestep=0.002 表示物理引擎以 2 ms 步长积分，即 500 Hz。
    gravity 使用世界坐标系，单位为 m/s^2；修改步长后应重新验证策略稳定性。
  -->
  <option timestep="0.002" gravity="0 0 -9.81" cone="elliptic" impratio="100"/>

  <default>
  <default class="black">
    <joint damping="0.1" armature="0.01" frictionloss="0.2"/>
    <!-- <joint frictionloss="0.2" damping="0.1"/>  -->
  </default>
  <default class="foot">
    <geom type="sphere" priority="1" solimp="0.015 1 0.02" condim="6" friction="0.6 0.02 0.01"/>
  </default>
   <default class="motor">
    <motor ctrlrange="-33.5 33.5"/>
   </default>
  </default>

