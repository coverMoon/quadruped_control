  <motor class="motor" joint="FL_thigh_joint"  gear="1"/>
  <motor class="motor" joint="FL_calf_joint"   gear="1"/>

  <!-- FR -->
  <motor class="motor" joint="FR_hip_joint"    gear="1"/>
  <motor class="motor" joint="FR_thigh_joint"  gear="1"/>
  <motor class="motor" joint="FR_calf_joint"   gear="1"/>

  <!-- RL -->
  <motor class="motor" joint="RL_hip_joint"    gear="1"/>
  <motor class="motor" joint="RL_thigh_joint"  gear="1"/>
  <motor class="motor" joint="RL_calf_joint"   gear="1"/>

  <!-- RR -->
