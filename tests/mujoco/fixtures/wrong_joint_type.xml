<!-- 测试 fixture：故意把 j2 定义为 ball 关节，不是适合单自由度控制的 hinge。 -->
<mujoco model="wrong_joint_type">
  <worldbody>
    <body name="base" pos="0 0 1">
      <freejoint/>
      <site name="imu" pos="0 0 0"/>
      <geom type="box" size="0.1 0.1 0.05" mass="1"/>
      <body name="link1" pos="0.1 0 0">
        <joint name="j1" axis="0 1 0"/>
        <geom type="capsule" size="0.02 0.1" mass="0.1"/>
        <body name="link2" pos="0 0 -0.15">
          <joint name="j2" type="ball"/>
          <geom type="capsule" size="0.02 0.1" mass="0.1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="j1"/>
  </actuator>
  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
  </sensor>
</mujoco>
